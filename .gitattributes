# cmd reads batch files with Windows line endings.
*.cmd text eol=crlf
# sh, Git Bash's too, cannot run a script with Windows line endings, which
# Git for Windows checks text files out with by default.
resources/bin/hoot text eol=lf
# The launcher of node, which Hoot puts on the PATH of its sessions on macOS.
resources/node/node text eol=lf

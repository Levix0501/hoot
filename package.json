{
  "name": "hoot",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "A desktop app that runs coding agent CLIs in an embedded terminal.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/start.ts",
    "app:package": "vite build && electron-builder --mac --dir -c.mac.notarize=false -c.electronDist=node_modules/electron/dist",
    "app:install": "pnpm app:package && node scripts/install-app.ts",
    "app:release": "vite build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-hoot-notary} electron-builder --mac --win --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.1.0-beta.304",
    "birpc": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.10",
    "get-east-asian-width": "^1.7.0",
    "lucide-react": "^1.53.0",
    "next-themes": "^0.4.6",
    "npm": "11.21.0",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "path-key": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3",
    "which": "^7.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.6",
  "productName": "Hoot"
}

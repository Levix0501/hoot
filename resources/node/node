#!/bin/sh
# node for the sessions Hoot starts on macOS, and for what Hoot runs to read
# or install agents. Hoot puts this folder last on their PATH, so that a node
# of the user's comes first; this one runs Hoot's own executable, which the
# environment names, as Node.js. Agents that need a node to run, such as
# Codex, then run on a Mac without Node.js too.
if [ -z "$HOOT_NODE" ]; then
  echo 'error: this node works only where Hoot runs it: HOOT_NODE is not set.' >&2
  exit 1
fi
ELECTRON_RUN_AS_NODE=1 exec "$HOOT_NODE" "$@"
